# pixi environments
.pixi/*
!.pixi/config.toml

# Large / generated data (the downloaded structures and extracted ligands).
# catalogue/ is intentionally NOT ignored — it is the tracked deliverable.
data/

# DrugCLIP -> GNINA docked screening sets (bulk input for the --docked-dir one-shot:
# a folder of <mol_id>_docked.sdf + a rank index_*.csv). Large, not a deliverable.
5KXI/

# Raw DrugCLIP/GNINA screening deposit (organised into data/screening/ by
# scripts/organise_screening.py; data/ is already ignored). drugclip_output/ is a
# superseded/mismatched index set. All bulk input, not deliverables.
out/
website_output/
drugclip_output/

# The full DrugCLIP screening compound library (~18.6M molecules, ~48 GB of vendor SDFs).
# The source library DrugCLIP screens against — bulk input, never tracked. The tracked
# summary of it is docs/molecule_library.md.
molecule_library/

# External reference material kept locally, not tracked (e.g. the TeachOpenCADD
# T009 tutorial the Stage-4 pharmacophore method is adapted from).
talktorial.ipynb

# Vendored third-party clones (pkasolver + its bundled model weights). Re-clone on a
# login node: git clone https://github.com/mayrf/pkasolver external/pkasolver
external/

# Transient working file pkasolver's dimorphite-dl step writes to the cwd during
# `protonate-ligands` (overwritten per ligand; not project state).
test.pkl

# Reconstructed-findings PyMOL sessions: heavy binaries, regenerable from the tracked
# pharmacophore.csv via `pixi run visualise-pharmacophore`. The PNG snapshots + models are
# tracked; the .pse are not.
results/**/*.pse

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db

# Local Claude Code settings & runtime locks (not project state)
.claude/
CLAUDE.md


.docs/